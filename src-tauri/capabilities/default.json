{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "qenc-default",
  "description": "Default permissions for QENC",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-unlisten",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:path:default",
    "core:resources:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write"
  ]
}